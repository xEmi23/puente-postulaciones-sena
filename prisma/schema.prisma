// Tres esquemas en una misma base PostgreSQL, uno por sistema:
//   origen  → portal de empleo simulado (equivalente al lado de LinkedIn Apply Connect)
//   puente  → middleware de integración (lo que realmente construye el equipo)
//   ats     → ATS de destino simulado (contrato del simulador, NO de BUK)
// Ningún esquema lee tablas de otro: se comunican solo por HTTP.
// `demo = true` marca filas que `npm run demo:reset` puede borrar y re-sembrar.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["origen", "puente", "ats"]
}

// ───────────────────────────── ORIGEN ─────────────────────────────

enum EstadoVacante {
  BORRADOR
  PUBLICADA
  CERRADA

  @@schema("origen")
}

enum EstadoOutbox {
  PENDIENTE
  ENVIADO
  FALLIDO

  @@schema("origen")
}

model Vacante {
  id            String              @id @default(uuid()) @db.Uuid
  codigo        String              @unique // externalJobId que viaja en el webhook
  titulo        String
  area          String
  ciudad        String
  modalidad     String
  descripcion   String
  estado        EstadoVacante       @default(PUBLICADA)
  publicadaEn   DateTime?           @db.Timestamptz(3)
  creadaEn      DateTime            @default(now()) @db.Timestamptz(3)
  actualizadaEn DateTime            @updatedAt @db.Timestamptz(3)
  demo          Boolean             @default(true)
  postulaciones PostulacionOrigen[]

  @@schema("origen")
}

model ArchivoCv {
  id            String             @id @default(uuid()) @db.Uuid
  nombreArchivo String
  mime          String
  tamano        Int
  sha256        String             @db.Char(64)
  contenido     Bytes
  mediaUrn      String             @unique
  expiraEn      DateTime           @db.Timestamptz(3)
  creadoEn      DateTime           @default(now()) @db.Timestamptz(3)
  postulacion   PostulacionOrigen?

  @@schema("origen")
}

model PostulacionOrigen {
  id               String         @id @default(uuid()) @db.Uuid
  jobApplicationId String         @unique // urn:li:jobApplication:{id}
  jobApplicant     String // urn:li:person:{id}, estable por correo
  vacanteId        String         @db.Uuid
  vacante          Vacante        @relation(fields: [vacanteId], references: [id], onDelete: Cascade)
  nombre           String
  apellido         String
  correo           String
  telefono         String?
  ciudad           String
  archivoCvId      String         @unique @db.Uuid
  archivoCv        ArchivoCv      @relation(fields: [archivoCvId], references: [id], onDelete: Cascade)
  aplicadaEn       DateTime       @default(now()) @db.Timestamptz(3)
  demo             Boolean        @default(true)
  outbox           OutboxOrigen[]

  @@index([vacanteId])
  @@map("Postulacion")
  @@schema("origen")
}

model OutboxOrigen {
  id               String                 @id @default(uuid()) @db.Uuid
  postulacionId    String?                @db.Uuid
  postulacion      PostulacionOrigen?     @relation(fields: [postulacionId], references: [id], onDelete: Cascade)
  // EXPORT_JOB_APPLICATION (postulación) | JOB_POSTING_STATUS (cierre/reapertura de vacante, contrato del simulador)
  tipo             String                 @default("EXPORT_JOB_APPLICATION")
  vacanteCodigo    String?
  payload          String // cuerpo JSON exacto que se firma y se envía
  estado           EstadoOutbox           @default(PENDIENTE)
  intentos         Int                    @default(0)
  proximoIntentoEn DateTime               @default(now()) @db.Timestamptz(3)
  bloqueadoHasta   DateTime?              @db.Timestamptz(3)
  ultimoError      String?
  creadoEn         DateTime               @default(now()) @db.Timestamptz(3)
  enviadoEn        DateTime?              @db.Timestamptz(3)
  intentosEntrega  IntentoEntregaOrigen[]

  @@index([estado, proximoIntentoEn])
  @@map("Outbox")
  @@schema("origen")
}

model IntentoEntregaOrigen {
  id          String       @id @default(uuid()) @db.Uuid
  outboxId    String       @db.Uuid
  outbox      OutboxOrigen @relation(fields: [outboxId], references: [id], onDelete: Cascade)
  numero      Int
  enviadoEn   DateTime     @default(now()) @db.Timestamptz(3)
  httpStatus  Int?
  codigoError String?
  respuesta   String?
  duracionMs  Int
  error       String?

  @@index([outboxId])
  @@map("IntentoEntrega")
  @@schema("origen")
}

// ───────────────────────────── PUENTE ─────────────────────────────

enum EstadoRecepcion {
  RECIBIDO
  PROCESANDO
  COMPLETADO
  RECHAZADO
  FALLIDO_REINTENTABLE
  REQUIERE_VERIFICACION

  @@schema("puente")
}

enum PasoRecepcion {
  cv_descargado
  candidato_creado
  documento_subido
  postulacion_creada

  @@schema("puente")
}

enum EstadoTrabajo {
  PENDIENTE
  EN_CURSO
  HECHO
  DETENIDO

  @@schema("puente")
}

model Recepcion {
  id                 String            @id @default(uuid()) @db.Uuid
  jobApplicationId   String            @unique
  jobApplicant       String
  externalJobId      String
  appliedAt          DateTime          @db.Timestamptz(3)
  payloadSha256      String            @db.Char(64)
  // Datos normalizados (minimizados) necesarios para crear el candidato en el ATS.
  nombre             String
  apellido           String
  correo             String
  telefono           String?
  ciudad             String?
  mediaUrl           String
  mediaUrn           String
  // Resultado del procesamiento
  estado             EstadoRecepcion   @default(RECIBIDO)
  paso               PasoRecepcion?
  procesoAtsId       Int?
  cvSha256           String?           @db.Char(64)
  cvTamano           Int?
  cvNombreArchivo    String?
  cvContenido        Bytes? // temporal: se borra al completar
  atsCandidatoId     String?
  atsDocumentoId     String?
  atsPostulacionId   String?
  errorCodigo        String?
  errorDetalle       String?
  duplicadosEvitados Int               @default(0)
  recibidaEn         DateTime          @default(now()) @db.Timestamptz(3)
  completadaEn       DateTime?         @db.Timestamptz(3)
  actualizadaEn      DateTime          @updatedAt @db.Timestamptz(3)
  demo               Boolean           @default(true)
  trabajo            Trabajo?
  eventos            EventoRecepcion[]

  @@index([estado])
  @@index([recibidaEn])
  @@schema("puente")
}

model Trabajo {
  id               String        @id @default(uuid()) @db.Uuid
  recepcionId      String        @unique @db.Uuid
  recepcion        Recepcion     @relation(fields: [recepcionId], references: [id], onDelete: Cascade)
  estado           EstadoTrabajo @default(PENDIENTE)
  intentos         Int           @default(0)
  proximoIntentoEn DateTime      @default(now()) @db.Timestamptz(3)
  leaseHasta       DateTime?     @db.Timestamptz(3)
  leaseDueno       String?
  ultimoError      String?
  creadoEn         DateTime      @default(now()) @db.Timestamptz(3)
  actualizadoEn    DateTime      @updatedAt @db.Timestamptz(3)

  @@index([estado, proximoIntentoEn])
  @@schema("puente")
}

model EventoRecepcion {
  id          String         @id @default(uuid()) @db.Uuid
  recepcionId String         @db.Uuid
  recepcion   Recepcion      @relation(fields: [recepcionId], references: [id], onDelete: Cascade)
  tipo        String // RECIBIDO, PASO, INTENTO_FALLIDO, RECHAZO, COMPLETADO, DUPLICADO, ...
  paso        PasoRecepcion?
  detalle     String
  creadoEn    DateTime       @default(now()) @db.Timestamptz(3)

  @@index([recepcionId, creadoEn])
  @@schema("puente")
}

// Entregas rechazadas antes de existir una Recepción (firma inválida, payload ilegible, vacante sin correspondencia).
model EntregaRechazada {
  id               String   @id @default(uuid()) @db.Uuid
  codigo           String
  motivo           String
  jobApplicationId String?
  externalJobId    String?
  recibidaEn       DateTime @default(now()) @db.Timestamptz(3)
  demo             Boolean  @default(true)

  @@index([recibidaEn])
  @@schema("puente")
}

model Correspondencia {
  id             String    @id @default(uuid()) @db.Uuid
  externalJobId  String    @unique
  procesoAtsId   Int
  descripcion    String
  activa         Boolean   @default(true)
  // Cierre propagado desde el origen: las postulaciones hechas antes de cerradaEn se respetan.
  motivoCierre   String? // ORIGEN | MANUAL
  cerradaEn      DateTime? @db.Timestamptz(3)
  estadoOrigenEn DateTime? @db.Timestamptz(3) // último cambio de estado aplicado (descarta eventos viejos)
  creadaEn       DateTime  @default(now()) @db.Timestamptz(3)
  actualizadaEn  DateTime  @updatedAt @db.Timestamptz(3)
  demo           Boolean   @default(true)

  @@schema("puente")
}

// ───────────────────────────── ATS (simulado) ─────────────────────────────

model Proceso {
  id            Int              @id // 9001, 9002 …
  nombre        String
  area          String
  ciudad        String
  estado        String           @default("ABIERTO")
  creadoEn      DateTime         @default(now()) @db.Timestamptz(3)
  demo          Boolean          @default(true)
  etapas        Etapa[]
  postulaciones PostulacionAts[]

  @@schema("ats")
}

model Etapa {
  id            String           @id @default(uuid()) @db.Uuid
  procesoId     Int
  proceso       Proceso          @relation(fields: [procesoId], references: [id], onDelete: Cascade)
  nombre        String
  orden         Int
  postulaciones PostulacionAts[]

  @@unique([procesoId, orden])
  @@schema("ats")
}

model Candidato {
  id                String           @id @default(uuid()) @db.Uuid
  nombre            String
  apellido          String
  correo            String           @unique // normalizado en minúsculas
  telefono          String?
  ciudad            String?
  referenciaExterna String?
  creadoEn          DateTime         @default(now()) @db.Timestamptz(3)
  demo              Boolean          @default(true)
  documentos        Documento[]
  postulaciones     PostulacionAts[]

  @@schema("ats")
}

model Documento {
  id            String           @id @default(uuid()) @db.Uuid
  candidatoId   String           @db.Uuid
  candidato     Candidato        @relation(fields: [candidatoId], references: [id], onDelete: Cascade)
  tipo          String           @default("CV")
  nombreArchivo String
  mime          String
  tamano        Int
  sha256        String           @db.Char(64)
  contenido     Bytes
  creadoEn      DateTime         @default(now()) @db.Timestamptz(3)
  postulaciones PostulacionAts[]

  @@index([candidatoId])
  @@schema("ats")
}

model PostulacionAts {
  id                String     @id @default(uuid()) @db.Uuid
  procesoId         Int
  proceso           Proceso    @relation(fields: [procesoId], references: [id], onDelete: Cascade)
  candidatoId       String     @db.Uuid
  candidato         Candidato  @relation(fields: [candidatoId], references: [id], onDelete: Cascade)
  etapaId           String     @db.Uuid
  etapa             Etapa      @relation(fields: [etapaId], references: [id])
  documentoId       String?    @db.Uuid
  documento         Documento? @relation(fields: [documentoId], references: [id], onDelete: SetNull)
  calificacion      String     @default("SIN_CALIFICAR")
  fuente            String
  referenciaExterna String     @unique // jobApplicationId de origen
  vista             Boolean    @default(false)
  creadaEn          DateTime   @default(now()) @db.Timestamptz(3)

  @@unique([procesoId, candidatoId])
  @@map("Postulacion")
  @@schema("ats")
}

model ClaveIdempotencia {
  clave         String   @id
  ruta          String
  hashSolicitud String   @db.Char(64)
  estadoHttp    Int
  respuesta     String
  creadaEn      DateTime @default(now()) @db.Timestamptz(3)

  @@schema("ats")
}

// Fallos inyectables del simulador. Solo se consultan con SIMULADOR_MODO_PRUEBA=true y fuera de producción.
model FalloSimulado {
  ruta      String   @id // candidatos | documentos | postulaciones | consulta | auth
  modo      String // NO_DISPONIBLE (503 sin escribir) | PERDER_RESPUESTA (escribe y responde 503) | LENTO (escribe tras 12 s) | CREDENCIALES (401)
  restantes Int      @default(1) // cuántas solicitudes afecta; -1 = indefinido
  creadoEn  DateTime @default(now()) @db.Timestamptz(3)

  @@schema("ats")
}
