# Generado por `npm run setup` con secretos aleatorios. Ningún valor real va en el repositorio.
# Base de PostgreSQL (cada app usa su propio esquema dentro de la misma base; DB_SCHEMA lo cambia en Render).
DATABASE_URL="postgresql://tb2:CAMBIAR@localhost:5435/tb2_dev"
DATABASE_URL_TEST="postgresql://tb2:CAMBIAR@localhost:5435/tb2_test"
DATABASE_URL_E2E="postgresql://tb2:CAMBIAR@localhost:5435/tb2_e2e"
# Tamaño máximo del CV en bytes (5 MB).
CV_MAX_BYTES="5242880"
# Firma de las sesiones de Better Auth (propia de esta app).
BETTER_AUTH_SECRET="CAMBIAR"
# URL pública del Puente (de aquí sale la URL del webhook que se registra en Vínculo).
APP_BASE_URL="http://localhost:3003"
# Cifra el Client Secret de Vínculo y la API Key de Talentia guardados en «Conexiones»: 64 caracteres hexadecimales.
PUENTE_CLAVE_CIFRADO="CAMBIAR"
# 1 = habilita «Controles de prueba» (inyección de fallos). Solo en local; nunca en la demo pública.
PUENTE_MODO_PRUEBAS="0"
# 1 = el procesador corre dentro del proceso web (como en Render); 0 = aparte (npm run worker -w apps/puente).
WORKER_EN_PROCESO="1"
# V4: ATS de destino: talentia (simulado, por defecto) o buk (deshabilitado: el procesador no arranca y /api/salud responde 503).
ATS_DESTINO="talentia"
# V4: días que el Puente conserva un CV que el ATS no recibió; los entregados se borran al completar.
RETENCION_CV_DIAS="30"
# V4: reintentos por postulación antes de quedar FALLIDA_DEFINITIVA.
PUENTE_MAX_INTENTOS="5"
