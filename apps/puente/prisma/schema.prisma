// Puente: el producto. Esquema "puente" (DB_SCHEMA).
// Modelo interno normalizado (Recepcion); los formatos externos viven solo en los adaptadores (src/entradas, src/salidas).
// `demo = true` marca filas que `npm run demo:reset` puede borrar y re-sembrar.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────── Autenticación (Better Auth; nombres de modelo que espera la librería) ─────────────

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  rol           String    @default("OPERADOR") // ADMIN | OPERADOR
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)
  demo          Boolean   @default(true)
  sessions      Session[]
  accounts      Account[]
}

model Session {
  id        String   @id
  expiresAt DateTime @db.Timestamptz(3)
  token     String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
}

// ───────────── Conexiones y publicación ─────────────

// Una fila por sistema (VINCULO | TALENTIA). Los secretos se guardan cifrados (AES-256-GCM, PUENTE_CLAVE_CIFRADO)
// y nunca vuelven completos a la interfaz.
model Conexion {
  tipo              String    @id // VINCULO | TALENTIA
  urlBase           String
  clientId          String? // Vínculo
  secretoCifrado    String // Client Secret de Vínculo o API Key de Talentia
  secretoFinal      String // últimos 4 caracteres, para mostrar ••••abcd
  empresaId         String? // companyId de Vínculo (empresa que autorizó la aplicación)
  empresaNombre     String?
  estadoPrueba      String    @default("SIN_PROBAR") // SIN_PROBAR | OK | FALLIDA
  detallePrueba     String?
  probadaEn         DateTime? @db.Timestamptz(3)
  permisoLectura    Boolean? // Talentia
  permisoEscritura  Boolean? // Talentia
  webhookValidadoEn DateTime? @db.Timestamptz(3) // último desafío de Vínculo respondido
  ultimoContactoEn  DateTime? @db.Timestamptz(3) // última respuesta del sistema (para estimar si está dormido)
  actualizadaEn     DateTime  @updatedAt @db.Timestamptz(3)
}

// Procesos de Talentia publicados en Vínculo por el puente (externalJobId = id del proceso).
model Publicacion {
  procesoId         Int       @id
  externalJobId     String    @unique
  titulo            String
  vacanteId         String? // id de la vacante en Vínculo
  url               String?
  estado            String    @default("PUBLICADA") // PUBLICADA | CERRADA | ERROR
  solicitudSencilla Boolean   @default(false)
  motivo            String?
  automatica        Boolean   @default(false)
  publicadaEn       DateTime? @db.Timestamptz(3)
  cerradaEn         DateTime? @db.Timestamptz(3)
  actualizadaEn     DateTime  @updatedAt @db.Timestamptz(3)
  demo              Boolean   @default(true)
}

model Configuracion {
  id                    Int       @id @default(1)
  publicacionAutomatica Boolean   @default(false)
  ultimoSondeoEn        DateTime? @db.Timestamptz(3)
  resultadoSondeo       String?
}

// Vínculos manuales vacante de Vínculo → proceso de Talentia, para vacantes creadas directamente en Vínculo.
model Correspondencia {
  id             String    @id @default(uuid()) @db.Uuid
  // V4: correspondencia genérica (fuente, vacante externa) → proceso del ATS. externalJobId sigue siendo la referencia
  // única: la vacante de Vínculo en apply-connect (como en la v2) y "<fuente>:<vacante>" en las demás fuentes.
  fuente         String    @default("apply-connect")
  vacanteExterna String? // null en filas apply-connect antiguas: se usa externalJobId
  externalJobId  String    @unique
  procesoAtsId   Int
  descripcion    String
  activa         Boolean   @default(true)
  // Al desvincular se guarda la hora: las postulaciones hechas antes se respetan (D-17).
  cerradaEn      DateTime? @db.Timestamptz(3)
  creadaEn       DateTime  @default(now()) @db.Timestamptz(3)
  actualizadaEn  DateTime  @updatedAt @db.Timestamptz(3)
  demo           Boolean   @default(true)

  @@unique([fuente, vacanteExterna])
}

// V4: fuentes de postulaciones (adaptadores de entrada). Cada una tiene su token: se muestra una sola vez y se guarda
// solo su SHA-256 (con un prefijo visible para reconocerlo). apply-connect es del sistema: usa la firma HMAC, sin token.
model Fuente {
  id            String    @id @default(uuid()) @db.Uuid
  nombre        String    @unique
  descripcion   String    @default("")
  sistema       Boolean   @default(false)
  tokenHash     String?   @db.Char(64)
  tokenPrefijo  String?
  activa        Boolean   @default(true)
  ultimoUsoEn   DateTime? @db.Timestamptz(3)
  revocadaEn    DateTime? @db.Timestamptz(3)
  creadaEn      DateTime  @default(now()) @db.Timestamptz(3)
  actualizadaEn DateTime  @updatedAt @db.Timestamptz(3)

  @@index([tokenPrefijo])
}

// V4: auditoría de cada acción manual y cada cambio de estado (sin datos personales).
model EventoAuditoria {
  id          String   @id @default(uuid()) @db.Uuid
  actorTipo   String // usuario | fuente | sistema
  actorId     String // id del usuario, nombre de la fuente o nombre del proceso del sistema
  accion      String
  recepcionId String?  @db.Uuid
  detalle     String?
  creadoEn    DateTime @default(now()) @db.Timestamptz(3)

  @@index([recepcionId, creadoEn])
  @@index([creadoEn])
}

// ───────────── Operaciones ─────────────

enum EstadoRecepcion {
  RECIBIDO
  REQUIERE_REVISION // V4: falta correo o CV, datos sin confirmar o posible duplicado; una persona decide
  PROCESANDO
  COMPLETADO
  RECHAZADO
  FALLIDO_REINTENTABLE
  REQUIERE_VERIFICACION
}

enum PasoRecepcion {
  cv_descargado
  postulante_listo
  documento_subido
  postulacion_creada
}

enum EstadoTrabajo {
  PENDIENTE
  EN_CURSO
  HECHO
  DETENIDO
}

model Recepcion {
  id                 String            @id @default(uuid()) @db.Uuid
  // V4: de qué fuente vino (la fija el token o el adaptador) y sus identificadores en ella. UNIQUE(fuente, idExterno)
  // es la deduplicación dura. Para Apply Connect, idExterno = jobApplicationId y vacanteExterna = externalJobId.
  fuente             String            @default("apply-connect")
  idExterno          String
  vacanteExterna     String
  // Referencia global de la recepción (Idempotency-Key y referencia_externa en el ATS). En Apply Connect es el
  // jobApplicationId de la entrega; en las demás fuentes, "<fuente>:<idExterno>".
  jobApplicationId   String            @unique
  jobApplicant       String
  externalJobId      String
  appliedAt          DateTime          @db.Timestamptz(3)
  payloadSha256      String            @db.Char(64)
  // Datos normalizados (minimizados) necesarios para crear el postulante en Talentia.
  nombre             String
  apellido           String
  correo             String? // V4: puede faltar (queda en revisión)
  telefono           String?
  ciudad             String?
  mediaUrl           String? // solo Apply Connect (CV por enlace)
  mediaUrn           String?
  // Resultado del procesamiento
  estado             EstadoRecepcion   @default(RECIBIDO)
  paso               PasoRecepcion?
  procesoAtsId       Int?
  cvSha256           String?           @db.Char(64)
  cvTamano           Int?
  cvNombreArchivo    String?
  cvContenido        Bytes? // temporal: se borra al completar
  atsPostulanteId    String?
  atsDocumentoId     String?
  atsPostulacionId   String?
  errorCodigo        String?
  errorDetalle       String?
  // V4: por qué espera a una persona (sin_correo, sin_cv, datos_sin_confirmar, posible_duplicado; separados por coma).
  motivoRevision     String?
  // V4: retención y supresión (los metadatos y el hash se conservan).
  cvBorradoEn        DateTime?         @db.Timestamptz(3)
  datosBorradosEn    DateTime?         @db.Timestamptz(3)
  // V4: se completó, pero con una salvedad visible (p. ej., «CV no enviado: el ATS no lo admite por API»).
  advertencia        String?
  // V4 F6: prueba del consentimiento (formulario público): fecha, versión del aviso de privacidad y origen resumido
  // (HMAC de la IP con la clave del Puente; la IP nunca se guarda en claro).
  consentimientoEn      DateTime? @db.Timestamptz(3)
  consentimientoVersion String?
  consentimientoOrigen  String?
  duplicadosEvitados Int               @default(0)
  recibidaEn         DateTime          @default(now()) @db.Timestamptz(3)
  completadaEn       DateTime?         @db.Timestamptz(3)
  // Aviso RESUME_DOWNLOADED a Vínculo: aparte del procesamiento, no bloquea el COMPLETADO.
  avisoEstado        String            @default("NO_APLICA") // NO_APLICA | PENDIENTE | ENVIADO | FALLIDO
  avisoIntentos      Int               @default(0)
  avisoProximoEn     DateTime?         @db.Timestamptz(3)
  avisoError         String?
  actualizadaEn      DateTime          @updatedAt @db.Timestamptz(3)
  demo               Boolean           @default(true)
  trabajo            Trabajo?
  eventos            EventoRecepcion[]

  @@unique([fuente, idExterno])
  @@index([fuente, estado])
  @@index([procesoAtsId, correo])
  @@index([estado])
  @@index([recibidaEn])
  @@index([avisoEstado, avisoProximoEn])
}

model Trabajo {
  id               String        @id @default(uuid()) @db.Uuid
  recepcionId      String        @unique @db.Uuid
  recepcion        Recepcion     @relation(fields: [recepcionId], references: [id], onDelete: Cascade)
  estado           EstadoTrabajo @default(PENDIENTE)
  intentos         Int           @default(0)
  proximoIntentoEn DateTime      @default(now()) @db.Timestamptz(3)
  leaseHasta       DateTime?     @db.Timestamptz(3)
  leaseDueno       String?
  ultimoError      String?
  creadoEn         DateTime      @default(now()) @db.Timestamptz(3)
  actualizadoEn    DateTime      @updatedAt @db.Timestamptz(3)

  @@index([estado, proximoIntentoEn])
}

model EventoRecepcion {
  id          String         @id @default(uuid()) @db.Uuid
  recepcionId String         @db.Uuid
  recepcion   Recepcion      @relation(fields: [recepcionId], references: [id], onDelete: Cascade)
  tipo        String // RECIBIDO, PASO, INTENTO_FALLIDO, RECHAZO, COMPLETADO, DUPLICADO, AVISO, ...
  paso        PasoRecepcion?
  detalle     String
  creadoEn    DateTime       @default(now()) @db.Timestamptz(3)

  @@index([recepcionId, creadoEn])
}

// Entregas rechazadas antes de existir una Recepción (firma inválida, payload ilegible, vacante sin proceso).
model EntregaRechazada {
  id               String   @id @default(uuid()) @db.Uuid
  codigo           String
  motivo           String
  jobApplicationId String?
  externalJobId    String?
  recibidaEn       DateTime @default(now()) @db.Timestamptz(3)
  demo             Boolean  @default(true)

  @@index([recibidaEn])
}

// Fallos inyectables en los conectores del puente (solo con PUENTE_MODO_PRUEBAS=1 en un entorno local).
model FalloSimulado {
  ruta      String   @id // candidatos | documentos | postulaciones | consulta | media
  modo      String // NO_DISPONIBLE | PERDER_RESPUESTA | LENTO | CREDENCIALES | INTERRUMPIR
  restantes Int      @default(1) // cuántas solicitudes afecta; -1 = indefinido
  creadoEn  DateTime @default(now()) @db.Timestamptz(3)
}

// ───────────── V4 F3 · Importador manual ─────────────

// Un lote de CV subidos por una persona: espera en esta tabla (con los PDF) hasta que la persona revisa la tabla y
// confirma. Al confirmar, cada fila entra por registrarRecepcion() (fuente = importador) y se borran los bytes de aquí.
model LoteImportacion {
  id           String               @id @default(uuid()) @db.Uuid
  usuarioId    String
  procesoAtsId Int
  creadoEn     DateTime             @default(now()) @db.Timestamptz(3)
  confirmadoEn DateTime?            @db.Timestamptz(3)
  archivos     ArchivoImportacion[]

  @@index([creadoEn])
}

model ArchivoImportacion {
  id            String          @id @default(uuid()) @db.Uuid
  loteId        String          @db.Uuid
  lote          LoteImportacion @relation(fields: [loteId], references: [id], onDelete: Cascade)
  orden         Int
  nombreArchivo String
  contenido     Bytes? // se borra al confirmar
  sha256        String?         @db.Char(64)
  tamano        Int
  // Lo que se pudo leer del PDF y lo que sugiere el Puente (sin IA); la persona lo corrige antes de confirmar.
  textoLeido    Boolean         @default(false)
  nombres       String          @default("")
  apellidos     String          @default("")
  correo        String          @default("")
  telefono      String          @default("")
  origenNombre  String          @default("archivo") // csv | archivo
  error         String? // archivo rechazado (no es PDF, demasiado grande)
  resultado     String? // RECIBIDA | REQUIERE_REVISION | DUPLICADA | ERROR (tras confirmar)
  recepcionId   String?         @db.Uuid

  @@index([loteId, orden])
}
