# Generado por `npm run setup` con secretos aleatorios. Ningún valor real va en el repositorio.
# Base de PostgreSQL (cada app usa su propio esquema dentro de la misma base; DB_SCHEMA lo cambia en Render).
DATABASE_URL="postgresql://tb2:CAMBIAR@localhost:5435/tb2_dev"
DATABASE_URL_TEST="postgresql://tb2:CAMBIAR@localhost:5435/tb2_test"
DATABASE_URL_E2E="postgresql://tb2:CAMBIAR@localhost:5435/tb2_e2e"
# Tamaño máximo del CV en bytes (5 MB).
CV_MAX_BYTES="5242880"
# Firma de las sesiones de Better Auth (propia de esta app).
BETTER_AUTH_SECRET="CAMBIAR"
# URL pública de Talentia.
APP_BASE_URL="http://localhost:3002"
