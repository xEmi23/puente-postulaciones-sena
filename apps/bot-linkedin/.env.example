# Bot asistido del Puente (V4 §8.3). `npm run demo:bot` genera apps/bot-linkedin/.env con el token. Sin contraseñas:
# la sesión del sitio se inicia A MANO con `npm run bot:login -w apps/bot-linkedin`.
# Sitio: vinculo (red simulada, por defecto) | linkedin (pendiente de la Puerta 0: se niega a correr).
BOT_SITIO="vinculo"
BOT_URL_SITIO="http://localhost:3001"
# Entrada genérica del Puente y token de la fuente (Puente → Fuentes; se ve una vez).
PUENTE_URL="http://localhost:3003"
PUENTE_BOT_TOKEN=""
# Límites y pausas. Si se dejan vacíos: Vínculo 800–1500 ms y horario libre; LinkedIn 3000–8000 ms y 07–19.
BOT_MAX_POR_EJECUCION="25"
BOT_PAUSA_MIN_MS=""
BOT_PAUSA_MAX_MS=""
BOT_HORARIO=""
# Ventana visible (recomendado). true solo para pruebas automáticas contra Vínculo.
BOT_HEADLESS="false"
