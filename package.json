{
  "name": "talent-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Prototipo SENA: portal de origen simulado, puente de integración, ATS simulado y panel.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node scripts/setup-env.mjs && node scripts/pg-local.mjs init && npm run db:migrate && npm run db:seed",
    "pg:start": "node scripts/pg-local.mjs start",
    "pg:stop": "node scripts/pg-local.mjs stop",
    "pg:status": "node scripts/pg-local.mjs status",
    "dev": "next dev -p 3100",
    "start": "next start -p 3100",
    "worker": "tsx worker/index.ts",
    "lint": "eslint .",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "next build && playwright test",
    "build": "prisma generate && next build",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy && prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "demo:reset": "tsx scripts/demo-reset.ts",
    "cv:generar": "tsx scripts/generar-cv.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "18.0.9",
    "next": "16.4.3",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "pdf-lib": "1.17.1",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.0.5"
  }
}
