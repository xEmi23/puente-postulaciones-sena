{
  "name": "puente-postulaciones",
  "version": "2.0.0",
  "private": true,
  "description": "Prototipo SENA v2: Vínculo (red profesional simulada), Talentia (ATS simulado) y el Puente que traslada las postulaciones por API.",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/vinculo",
    "apps/talentia",
    "apps/puente"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "pg:start": "node scripts/pg-local.mjs start",
    "pg:stop": "node scripts/pg-local.mjs stop",
    "pg:status": "node scripts/pg-local.mjs status",
    "dev": "node scripts/dev.mjs dev",
    "start": "node scripts/dev.mjs start",
    "build": "npm run build --workspaces",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "test:e2e": "npm run build && playwright test",
    "db:migrate": "npm run db:migrate --workspaces",
    "db:seed": "npm run db:seed --workspaces",
    "demo:reset": "npm run demo:reset --workspaces",
    "cv:generar": "tsx scripts/generar-cv.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "dotenv": "18.0.9",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "pdf-lib": "1.17.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
