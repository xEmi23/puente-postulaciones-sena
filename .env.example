# Copia este archivo a .env (o ejecuta `npm run setup`, que lo genera con secretos aleatorios).
# Ningún valor real va en el repositorio.

# PostgreSQL. `npm run setup` crea un clúster local del proyecto en el puerto 5433.
DATABASE_URL="postgresql://talentbridge:CAMBIAR@localhost:5433/tb_dev"
# Base exclusiva para Vitest (se vacía en cada ejecución).
DATABASE_URL_TEST="postgresql://talentbridge:CAMBIAR@localhost:5433/tb_test"
# Base exclusiva para Playwright.
DATABASE_URL_E2E="postgresql://talentbridge:CAMBIAR@localhost:5433/tb_e2e"

# URL pública de la aplicación (los tres módulos viven en la misma app Next.js).
APP_BASE_URL="http://localhost:3100"
# Única base desde la que el puente acepta descargar CV (mediaUrl).
ORIGEN_BASE_URL="http://localhost:3100"
# Webhook del puente al que el despachador del origen envía las postulaciones.
PUENTE_WEBHOOK_URL="http://localhost:3100/api/puente/webhook"
# API del ATS simulado (contrato del simulador, no de BUK).
ATS_BASE_URL="http://localhost:3100/api/ats/v1"

# Secreto compartido origen ↔ puente para firmar (equivale al clientSecret de la app de LinkedIn).
SIM_CLIENT_SECRET="CAMBIAR"
# Token Bearer con el que el puente descarga CV del origen (equivale al access token de LinkedIn).
ORIGEN_MEDIA_ACCESS_TOKEN="CAMBIAR"
# Clave con la que el puente llama al ATS simulado.
ATS_API_KEY="CAMBIAR"

# Límites
CV_MAX_BYTES="5242880"
MEDIA_TTL_DAYS="30"

# Panel del puente: autenticación de demostración (solo funciona con DEMO_AUTH_ENABLED=true y NODE_ENV distinto de production).
DEMO_AUTH_ENABLED="true"
DEMO_ADMIN_USER="demo"
DEMO_ADMIN_PASSWORD="CAMBIAR"
SESSION_SECRET="CAMBIAR"

# Controles de fallos del simulador (solo pruebas). Nunca activar en la demo normal.
SIMULADOR_MODO_PRUEBA="false"
